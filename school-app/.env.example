# Athar settings (the Python package is still called athar, so the names start with ATHAR_).
# Every variable is optional: the defaults below work on one machine with LM Studio running.
# The step-by-step guide is docs/GETTING-STARTED.md.
#
# IMPORTANT: Athar reads these from the process environment. It does not load a .env
# file by itself. Export them in your shell (PowerShell: $env:ATHAR_LLM_MODEL = "..."),
# or load this file with your own tooling. Never commit a real .env file or any API key;
# .gitignore already excludes .env and .env.*.

# ---- Storage and curriculum -------------------------------------------------------------
# SQLite file holding learners, evidence, findings, approvals and the audit log.
# Run records and the agent checkpoints are written next to it (data/runs, data/checkpoints.db).
# ATHAR_DB=data/athar.db   (default: <repo>/data/athar.db)

# Folder that holds curriculum packs (one folder per pack, each with a pack.yaml).
# ATHAR_PACKS=packs        (default: <repo>/packs)

# Pack id used when a learner row does not name one, and by `athar seed`.
# ATHAR_PACK=generic-maths

# ---- The local open-weights model (any OpenAI-compatible endpoint) -----------------------
# Default: LM Studio on this machine, serving qwen3.5-9b.
ATHAR_LLM_BASE_URL=http://localhost:1234/v1
ATHAR_LLM_MODEL=qwen3.5-9b
# LM Studio ignores the key; some servers need any non-empty string. Not a secret here.
ATHAR_LLM_API_KEY=lm-studio

# Ollama instead (run `ollama serve`, then `ollama pull <model>`):
# ATHAR_LLM_BASE_URL=http://localhost:11434/v1
# ATHAR_LLM_MODEL=qwen3:8b
# ATHAR_LLM_API_KEY=ollama
#
# vLLM instead:
# ATHAR_LLM_BASE_URL=http://localhost:8000/v1
# ATHAR_LLM_MODEL=<the model name vLLM was started with>

# Reasoning effort sent to the local model. "none" (default) turns thinking off, which measured
# about 70 s per call with thinking and under 1 s without on qwen3.5-9b. Set "default" to send
# no reasoning setting at all, or any other value your server accepts (for example "low").
# ATHAR_LLM_REASONING=none

# ---- Optional frontier model (never required) --------------------------------------------
# Used only by `athar run ... --frontier`. Leave empty to stay fully local. Put a real key in
# your shell or a private, git-ignored .env, never in this file.
# ATHAR_FRONTIER_BASE_URL=
# ATHAR_FRONTIER_MODEL=
# ATHAR_FRONTIER_API_KEY=

# ---- Servers -----------------------------------------------------------------------------
# Teacher app (uv run athar demo).
# ATHAR_WEB_HOST=127.0.0.1
# ATHAR_WEB_PORT=8765

# MCP server over HTTP (uv run athar mcp --http). The HTTP server always binds 127.0.0.1.
# ATHAR_MCP_PORT=8766

# ---- Borrowed MCP server (document conversion) ---------------------------------------------
# Command used to start Microsoft's markitdown-mcp over stdio. `uvx` ships with uv and fetches
# the package from PyPI the first time it is used.
# ATHAR_MARKITDOWN_CMD=uvx
# ATHAR_MARKITDOWN_ARGS=markitdown-mcp

# ---- Set by the agent, not by you ----------------------------------------------------------
# When the agent starts our MCP server it sets these so the audit log names the caller.
# If you start the MCP server yourself, ATHAR_ACTOR labels your calls in audit_log
# (default "mcp-client"); ATHAR_RUN_ID is left empty.
# ATHAR_ACTOR=mcp-client
# ATHAR_RUN_ID=

# ---- Optional cloud models, for comparing with the local one ---------------------------------
# Leave these unset to stay fully local. With one set, the Agent page offers that provider's models.
# A cloud run sends the document and the records it reads to that company: synthetic data only.
# You can also paste a key on the Agent page instead; it is then kept in memory only.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Language ---------------------------------------------------------------------------
# The language the page opens in, the made-up school is written in, and findings are worded in.
# ATHAR_LANGUAGE=ar          (ar or en; default ar. A reader can switch on the page.)
# Arabic findings use fixed sentences written in code. "model" lets the model word them instead.
# ATHAR_ARABIC_WORDING=fixed
