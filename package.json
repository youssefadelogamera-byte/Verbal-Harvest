{
  "name": "verbal-harvest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Verbal Harvest — AI-powered English speaking & communication app aligned to the CEFR (Pre-A1 to C2) for children, teens, adults and business learners.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test --test-concurrency=1 server/tests/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  }
}
